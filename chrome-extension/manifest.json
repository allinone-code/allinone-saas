{
  "manifest_version": 3,
  "name": "Cerberus Ürün Yakalayıcı",
  "version": "1.0.0",
  "description": "Perakende sitesindeki ürün sayfasından fiyat, GTIN ve marka verisini alıp Cerberus'a kaydeder.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://allinone-saas-allinone-code.vercel.app/*"
  ],
  "action": {
    "default_title": "Cerberus — Ürünü Yakala",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
